* text=auto
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.slnx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.py text eol=lf

# Preserve supplied evidence bytes and their recorded SHA-256 values.
planning/logging/sources/** -text
planning/logging/evidence/** -text -whitespace
planning/environment-options/evidence/** -text -whitespace
planning/type-manager/sources/** -text -whitespace
planning/type-manager/evidence/** -text -whitespace
implementations/csharp/verification/contracts/type-manager/** -text -whitespace
# Package boundary checks compare the exact reviewed MSBuild target bytes.
implementations/csharp/build/type-manager/**/*.targets -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Raw JSONL compatibility controls include intentional BOM/missing-LF samples.
conformance/logging/compatibility/samples/wire/** -text

# CIS configuration has stable LF bytes; retained diagnostics keep original bytes.
.gitattributes text eol=lf
.cis/*.yml text eol=lf
.cis/.gitignore text eol=lf
.cis/import-mode text eol=lf
docs/cis/*.yml text eol=lf
planning/cis/evidence/** -text whitespace=-blank-at-eof,cr-at-eol

# Preserve the supplied review and hash-indexed native correction evidence verbatim.
planning/logging/reviews/**/source-review.md -text -whitespace
planning/logging/reviews/**/evidence/** -text -whitespace

# Preserve byte-pinned Claude review submissions and raw responses.
planning/reviews/corrective-2026-10-16/*.json -text -whitespace

# Preserve the byte-pinned publication migration checkpoint reports and audit.
planning/evidence/corrective-publication-validation-migration-2026-10-17/*.json -text -whitespace

# Preserve native compiler-control report bytes.
planning/evidence/corrective-compiler-checks-migration-2026-10-18/*.json -text -whitespace

# Preserve byte-pinned compiler/dependency migration evidence.
planning/evidence/corrective-dependency-checks-migration-2026-10-18/*.json -text -whitespace

# Preserve frozen Type Manager migration report bytes.
planning/evidence/corrective-type-manager-frozen-migration-2026-10-18/*.json -text -whitespace

# Preserve original Type Manager baseline migration reports.
planning/evidence/corrective-type-manager-baseline-migration-2026-10-18/*.json -text -whitespace

# Preserve native Type Manager SDK migration checkpoints and audit.
planning/evidence/corrective-type-manager-sdk-migration-2026-10-18/*.json -text -whitespace
