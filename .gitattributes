# Package boundary checks compare the exact reviewed MSBuild target bytes.
implementations/csharp/build/type-manager/**/*.targets -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Raw JSONL compatibility controls include intentional BOM/missing-LF samples.
conformance/logging/compatibility/samples/wire/** -text

# CIS configuration has stable LF bytes; retained diagnostics keep original bytes.
.gitattributes text eol=lf
.cis/*.yml text eol=lf
