* text=auto
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.slnx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.py text eol=lf

# Preserve supplied evidence bytes and their recorded SHA-256 values.
planning/logging/sources/** -text
planning/logging/evidence/** -text -whitespace
