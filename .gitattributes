* text=auto
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.slnx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.py text eol=lf

# Preserve supplied evidence bytes and their recorded SHA-256 values.
planning/logging/sources/** -text
planning/logging/evidence/** -text -whitespace
planning/environment-options/evidence/** -text -whitespace
planning/type-manager/sources/** -text -whitespace
planning/type-manager/evidence/** -text -whitespace
implementations/csharp/verification/contracts/type-manager/** -text -whitespace

# Raw JSONL compatibility controls include intentional BOM/missing-LF samples.
conformance/logging/compatibility/samples/wire/** -text

# CIS configuration has stable LF bytes; retained diagnostics keep original bytes.
.gitattributes text eol=lf
.cis/*.yml text eol=lf
.cis/.gitignore text eol=lf
.cis/import-mode text eol=lf
docs/cis/*.yml text eol=lf
planning/cis/evidence/** -text whitespace=-blank-at-eof,cr-at-eol
