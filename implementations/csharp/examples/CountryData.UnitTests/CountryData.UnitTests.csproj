<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CIS.CountryData.UnitTests</AssemblyName>
    <RootNamespace>CIS.Examples.CountryData.UnitTests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <UseVSTest>true</UseVSTest>
    <EnableMSTestRunner>false</EnableMSTestRunner>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" PrivateAssets="all" />
    <PackageReference Include="MSTest.TestFramework" PrivateAssets="all" />
    <PackageReference Include="MSTest.TestAdapter" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CountryData/CountryData.csproj" />
    <ProjectReference Include="../../src/CIS.CommonTesting/CIS.CommonTesting.csproj" />
  </ItemGroup>
</Project>
