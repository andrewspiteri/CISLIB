<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>CIS.Heartbeat.Examples.Polling</AssemblyName>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <CisHeartbeatPackageVersion Condition="'$(CisHeartbeatPackageVersion)' == ''">0.1.0-dev.1</CisHeartbeatPackageVersion>
    <ManagePackageVersionsCentrally Condition="'$(CisHeartbeatUsePackage)' == 'true'">false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../../src/CIS.Core/CIS.Core.csproj" Condition="'$(CisHeartbeatUsePackage)' != 'true'" />
    <PackageReference Include="CIS.Core" Version="$(CisHeartbeatPackageVersion)" Condition="'$(CisHeartbeatUsePackage)' == 'true'" />
  </ItemGroup>
</Project>
