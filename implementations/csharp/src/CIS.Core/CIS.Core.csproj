<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CIS.Core</AssemblyName>
    <RootNamespace>CIS</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>CIS.Core</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/andrewspiteri/CISLIB</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/andrewspiteri/CISLIB</PackageProjectUrl>
    <Version>0.1.0-dev.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>0.1.0.1</FileVersion>
    <SignAssembly>false</SignAssembly>
    <PublicSign>false</PublicSign>
    <DelaySign>false</DelaySign>
    <Description>CisLib multi-module core library with bounded logging and Microsoft ILogger integration.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CIS.Core.UnitTests" />
    <InternalsVisibleTo Include="CIS.Core.ArchitectureTests" />
    <InternalsVisibleTo Include="CIS.Core.DiscoveryFixture" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="../../eng/CIS.TypeManager.Build/CIS.TypeManager.Build.csproj"
                      ReferenceOutputAssembly="false" Private="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed;PublishAot;OutputPath;OutDir;_CommandLineDefinedOutputPath;CisTypeManagerEnabled" />
    <None Include="../../../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
  <Import Project="../../build/type-manager/package/CIS.TypeManager.Pack.targets" />
</Project>
