<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CIS.Core</AssemblyName>
    <RootNamespace>CIS</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>CIS.Core</PackageId>
    <Version>0.1.0-dev.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>0.1.0.1</FileVersion>
    <SignAssembly>false</SignAssembly>
    <PublicSign>false</PublicSign>
    <DelaySign>false</DelaySign>
    <Description>CisLib multi-module core library. Initial logging configuration support.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CIS.Core.UnitTests" />
    <InternalsVisibleTo Include="CIS.Core.ArchitectureTests" />
    <InternalsVisibleTo Include="CIS.Core.DiscoveryFixture" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <None Include="../../../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
