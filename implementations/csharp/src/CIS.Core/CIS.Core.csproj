<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CIS.Core</AssemblyName>
    <RootNamespace>CIS</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>CIS.Core</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/andrewspiteri/CISLIB</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/andrewspiteri/CISLIB</PackageProjectUrl>
    <Version>0.1.0-dev.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>0.1.0.1</FileVersion>
    <SignAssembly>false</SignAssembly>
    <PublicSign>false</PublicSign>
    <DelaySign>false</DelaySign>
    <Description>CisLib multi-module core library with bounded logging and Microsoft ILogger integration.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Retain the explicitly approved package closure alongside the approved ASP.NET shared framework. -->
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="CIS.Core.UnitTests" />
    <InternalsVisibleTo Include="CIS.Core.IntegrationTests" />
    <InternalsVisibleTo Include="CisHealthProbe" />
    <InternalsVisibleTo Include="CIS.Core.ArchitectureTests" />
    <InternalsVisibleTo Include="CIS.Core.DiscoveryFixture" />
    <InternalsVisibleTo Include="CIS.Metrics.OpenTelemetry" />
    <InternalsVisibleTo Include="CIS.RestClient.Resilience" />
    <InternalsVisibleTo Include="CIS.Messaging.RabbitMQ" />
    <InternalsVisibleTo Include="CIS.Security.Certificates" />
    <InternalsVisibleTo Include="CIS.Security.Entra" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="../../eng/CIS.TypeManager.Build/CIS.TypeManager.Build.csproj" ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed;PublishAot;OutputPath;OutDir;_CommandLineDefinedOutputPath;CisTypeManagerEnabled" />
    <None Include="../../../../README.md" Pack="true" PackagePath="README.md" />
    <EmbeddedResource Include="Operations/PostgreSql/install-v1.sql" LogicalName="CIS.Operations.PostgreSql.install-v1.sql" />
    <None Update="Operations/PostgreSql/install-v1.sql" Pack="true" PackagePath="contentFiles/any/any/CIS.Operations/PostgreSql/install-v1.sql" />
    <EmbeddedResource Include="Messaging/PostgreSql/install-v2.sql" LogicalName="CIS.Messaging.PostgreSql.install-v2.sql" />
    <None Update="Messaging/PostgreSql/install-v2.sql" Pack="true" PackagePath="contentFiles/any/any/CIS.Messaging/PostgreSql/install-v2.sql" />
    <EmbeddedResource Include="Coordination/PostgreSql/install-v1.sql" LogicalName="CIS.Coordination.PostgreSql.install-v1.sql" />
    <None Update="Coordination/PostgreSql/install-v1.sql" Pack="true" PackagePath="contentFiles/any/any/CIS.Coordination/PostgreSql/install-v1.sql" />
  </ItemGroup>
  <Import Project="../../build/type-manager/package/CIS.TypeManager.Pack.targets" />
</Project>
