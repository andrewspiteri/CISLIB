<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CIS.Messaging.RabbitMQ</AssemblyName>
    <RootNamespace>CIS.Messaging.RabbitMQ</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>CIS.Messaging.RabbitMQ</PackageId>
    <Version>0.1.0-dev.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Optional bounded RabbitMQ transport and native identity integration for CIS messaging.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../CIS.Core/CIS.Core.csproj" />
    <PackageReference Include="RabbitMQ.Client" />
    <None Update="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
