      <package pattern="Testcontainers.RabbitMq" />
      <package pattern="Testcontainers" />
      <package pattern="Docker.DotNet.Enhanced" />
      <package pattern="Docker.DotNet.Enhanced.X509" />
      <package pattern="Docker.DotNet.Enhanced.Handler.Abstractions" />
      <package pattern="Docker.DotNet.Enhanced.LegacyHttp" />
