<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CIS.Tests.Verification</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="../VerificationSuites.props" />
  <ItemGroup>
    <Compile Include="@(VerificationUnitSource);@(VerificationArchitectureSource)" />
    <Compile Include="../CIS.Core.ArchitectureTests/Publications/*.cs" />
    <Compile Include="../CIS.Core.ArchitectureTests/Contracts/*.cs" />
    <ProjectReference Include="../../eng/CIS.DependencyChecker/CIS.DependencyChecker.csproj" />
    <ProjectReference Include="../../src/CIS.Core/CIS.Core.csproj" />
    <ProjectReference Include="../CIS.Core.TestSupport/CIS.Core.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(CisHistoricalVerification)' != 'true'">
    <Compile Remove="@(HistoricalVerificationArchitectureSource)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
  </ItemGroup>
</Project>
