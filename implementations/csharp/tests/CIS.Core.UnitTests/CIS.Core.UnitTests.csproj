<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CIS.Tests.UnitTests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- Exercise function-pointer Type rejection without enabling unsafe code in Core. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CIS.Core/CIS.Core.csproj" />
    <ProjectReference Include="../CIS.Core.TestSupport/CIS.Core.TestSupport.csproj" />
  </ItemGroup>
  <Import Project="../UnitFixtures.props" />
  <Import Project="../VerificationSuites.props" />
  <ItemGroup>
    <Compile Remove="@(VerificationUnitSource)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
  </ItemGroup>
  <ItemGroup Condition="'$(CisMutationTesting)' == 'true' and '$(CisHealthcheckMutationCohort)' == 'true'">
    <Compile Remove="@(Compile)" />
    <Compile Include="Healthcheck/**/*.cs" />
  </ItemGroup>
  <!-- The fixed native pilot keeps every maintained direct contract, binder and
       consumer test for its four production files. Complete Unit and the other
       mutation groups retain their full declared source sets. TestAssembly.cs
       is linked afterward by tests/Directory.Build.targets in both modes. -->
  <ItemGroup Condition="'$(CisMutationTesting)' == 'true' and '$(CisHealthcheckMutationCohort)' == 'true' and '$(CisHealthcheckPilotCohort)' == 'true'">
    <Compile Remove="@(Compile)" />
    <Compile Include="Healthcheck/Foundation/HealthcheckValueContractTests.cs" />
    <Compile Include="Healthcheck/Foundation/HealthcheckContractMutationQualificationTests.cs" />
    <Compile Include="Healthcheck/Foundation/HealthDiagnosticRuntimeAcceptanceBoundaryTests.cs" />
    <Compile Include="Healthcheck/Execution/HealthExecutionBinderTests.cs" />
    <Compile Include="Healthcheck/Execution/HealthBindingRetirementBoundaryTests.cs" />
    <Compile Include="Healthcheck/Execution/HealthExecutionFactValidationTests.cs" />
    <Compile Include="Healthcheck/Execution/HealthExecutionPayloadMutationQualificationTests.cs" />
    <Compile Include="Healthcheck/Execution/HealthExecutionSparseFactQualificationTests.cs" />
    <Compile Include="Healthcheck/Execution/HealthExecutionWithdrawalObservationTests.cs" />
    <Compile Include="Healthcheck/Execution/HealthRegistrationDiagnosticTests.cs" />
    <Compile Include="Healthcheck/Core/HealthcheckLifecycleQualificationTests.cs" />
    <Compile Include="Healthcheck/Reporting/HealthReportFormatterBoundaryQualificationTests.cs" />
    <Compile Include="Healthcheck/Reporting/HealthReportFormatterMutationQualificationTests.cs" />
    <Compile Include="Healthcheck/Reporting/HealthReportFormatterTests.cs" />
  </ItemGroup>
  <!-- Both explicit Healthcheck selections need this non-test fixture helper. -->
  <ItemGroup Condition="'$(CisMutationTesting)' == 'true' and '$(CisHealthcheckMutationCohort)' == 'true'">
    <Compile Include="QualificationFixtureInputs.cs" />
  </ItemGroup>
  <!-- Apply after cohort selections: this is an explicit privileged Linux platform lane. -->
  <ItemGroup Condition="'$(CisLinuxIdentityQualification)' != 'true'">
    <Compile Remove="Healthcheck/Reporting/HealthPipeForeignOwnerBoundaryTests.cs" />
  </ItemGroup>
</Project>
