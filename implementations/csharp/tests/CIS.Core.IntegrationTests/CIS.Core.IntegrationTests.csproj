<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CIS.Tests.IntegrationTests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CIS.Core/CIS.Core.csproj" />
    <Compile Include="../fixtures/DiscoveryHost/ConfigurationReadExpectations.cs" Link="ConfigurationReadExpectations.cs" />
    <ProjectReference Include="../CIS.Core.TestSupport/CIS.Core.TestSupport.csproj" />
    <ProjectReference Include="../fixtures/DiscoveryHost/CIS.Core.DiscoveryFixture.csproj" />
    <Compile Include="../fixtures/DiscoveryHost/ExceptionBoundaryExpectations.cs" Link="ExceptionBoundaryExpectations.cs" />
    <Compile Include="../fixtures/DiscoveryHost/ExceptionBoundarySources.cs" Link="ExceptionBoundarySources.cs" />
    <Compile Include="../fixtures/DiscoveryHost/ExceptionContentSources.cs" Link="ExceptionContentSources.cs" />
    <Compile Include="../fixtures/DiscoveryHost/ExceptionContentProbe.cs" Link="ExceptionContentProbe.cs" />
    <Compile Include="../fixtures/DiscoveryHost/ExceptionContentExpectations.cs" Link="ExceptionContentExpectations.cs" />
    <Compile Include="../fixtures/DiscoveryHost/OperationScopeQualificationExpectations.cs" Link="OperationScopeQualificationExpectations.cs" />
    <Compile Include="../fixtures/DiscoveryHost/EventProjectionExpectations.cs" Link="EventProjectionExpectations.cs" />
    <Compile Include="../fixtures/DiscoveryHost/EventCorrelationExpectations.cs" Link="EventCorrelationExpectations.cs" />
    <Compile Include="../fixtures/DiscoveryHost/EventEncodingExpectations.cs" Link="EventEncodingExpectations.cs" />
  </ItemGroup>
  <Target Name="CopyDiscoveryFixture" AfterTargets="Build">
    <ItemGroup>
      <DiscoveryFixtureFiles Include="../fixtures/DiscoveryHost/bin/$(Configuration)/$(TargetFramework)/*" />
    </ItemGroup>
    <Copy SourceFiles="@(DiscoveryFixtureFiles)" DestinationFolder="$(TargetDir)discovery-fixture" />
  </Target>
</Project>
