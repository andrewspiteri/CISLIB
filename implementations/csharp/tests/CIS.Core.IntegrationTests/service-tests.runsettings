<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
    <TestSessionTimeout>1200000</TestSessionTimeout>
    <EnvironmentVariables>
      <CORE_SERVICE_NAME>cislib-rm04-tests</CORE_SERVICE_NAME>
      <CORE_ENVIRONMENT>Development</CORE_ENVIRONMENT>
    </EnvironmentVariables>
  </RunConfiguration>
  <MSTest>
    <MapInconclusiveToFailed>true</MapInconclusiveToFailed>
    <TreatDiscoveryWarningsAsErrors>true</TreatDiscoveryWarningsAsErrors>
    <TreatClassAndAssemblyCleanupWarningsAsErrors>true</TreatClassAndAssemblyCleanupWarningsAsErrors>
  </MSTest>
</RunSettings>
