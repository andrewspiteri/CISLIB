<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CIS.Tests.UnitTests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)../../verification/fast.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <Import Project="../VerificationSuites.props" />
  <Import Project="../UnitFixtures.props" />
  <ItemGroup>
    <Compile Include="../CIS.Core.UnitTests/**/*.cs" Exclude="../CIS.Core.UnitTests/bin/**;../CIS.Core.UnitTests/obj/**" />
    <Compile Remove="@(ExtendedUnitSource)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
    <Compile Remove="@(FastIsolationSource)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
    <Compile Remove="@(FastLoggingSource)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
    <ProjectReference Include="../../src/CIS.Core/CIS.Core.csproj" />
    <ProjectReference Include="../CIS.Core.TestSupport/CIS.Core.TestSupport.csproj" />
  </ItemGroup>
</Project>
