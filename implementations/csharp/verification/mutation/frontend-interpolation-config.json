{
  "stryker-config": {
    "project": "CIS.Core.csproj",
    "test-projects": ["../../tests/CIS.Core.UnitTests/CIS.Core.UnitTests.csproj"],
    "test-case-filter": "FullyQualifiedName~IncomingRingBufferTests|FullyQualifiedName~IncomingBatchIndexTests|FullyQualifiedName~InterpolationTests|FullyQualifiedName~IncomingEventQueueTests|FullyQualifiedName~IncomingFrontendTests|FullyQualifiedName~IncomingRuntimeTests|FullyQualifiedName~IncomingStartupTests|FullyQualifiedName~IncomingLifecycleTests|FullyQualifiedName~TestAssemblySetup.SchedulingMatchesRequestedMode",
    "test-runner": "vstest",
    "target-framework": "net10.0",
    "configuration": "Release",
    "mutate": [
      "Logging/Runtime/IncomingRingBuffer.cs",
      "Logging/Runtime/IncomingBatchIndex.cs",
      "Logging/Events/CapturedInterpolation.cs",
      "Logging/Events/InterpolationCapture.cs",
      "Logging/LogInterpolatedStringHandler.cs",
      "Logging/CoreLogger.Interpolation.cs"
    ],
    "mutation-level": "Complete",
    "reporters": ["json", "html", "progress", "cleartext"],
    "concurrency": 4,
    "additional-timeout": 10000,
    "thresholds": { "high": 100, "low": 90, "break": 90 }
  }
}
