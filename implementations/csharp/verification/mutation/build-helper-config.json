{
  "stryker-config": {
    "project": "CIS.TypeManager.Build.csproj",
    "test-projects": [
      "../../tests/CIS.Core.ArchitectureTests/CIS.Core.ArchitectureTests.csproj"
    ],
    "test-case-filter": "FullyQualifiedName~CIS.Tests.BuildHelper.WriteTypeInventoryTests",
    "test-runner": "vstest",
    "target-framework": "net10.0",
    "configuration": "Release",
    "mutate": [
      "**/*.cs"
    ],
    "mutation-level": "Complete",
    "coverage-analysis": "off",
    "reporters": [
      "json",
      "html",
      "progress"
    ],
    "concurrency": 1,
    "additional-timeout": 10000,
    "thresholds": {
      "high": 100,
      "low": 90,
      "break": 90
    }
  }
}
