{
  "stryker-config": {
    "project": "CIS.Core.csproj",
    "test-projects": [
      "../../tests/CIS.Core.UnitTests/CIS.Core.UnitTests.csproj"
    ],
    "test-runner": "vstest",
    "target-framework": "net10.0",
    "configuration": "Release",
    "test-case-filter": "FullyQualifiedName~CIS.Tests.UnitTests.Provider",
    "mutate": [
      "Logging/MicrosoftLogger/*.cs"
    ],
    "mutation-level": "Complete",
    "reporters": [
      "json",
      "html",
      "progress",
      "cleartext"
    ],
    "concurrency": 2,
    "additional-timeout": 10000,
    "thresholds": {
      "high": 100,
      "low": 90,
      "break": 90
    }
  }
}
