{
  "stryker-config": {
    "project": "CIS.Core.csproj",
    "test-projects": [
      "../../tests/CIS.Core.UnitTests/CIS.Core.UnitTests.csproj"
    ],
    "test-case-filter": "(FullyQualifiedName~CIS.Tests.UnitTests.Configuration.ConfigurationCommitTests|FullyQualifiedName~CIS.Tests.UnitTests.Configuration.ConfigurationMappingTests)&TestCategory!=PerformanceObservation&TestCategory!=ExtendedStress",
    "test-runner": "vstest",
    "target-framework": "net10.0",
    "configuration": "Release",
    "mutate": [
      "Configuration/Mapping/ConfigurationValuePipeline.cs{3372..5423}"
    ],
    "mutation-level": "Complete",
    "coverage-analysis": "off",
    "reporters": [
      "json",
      "progress"
    ],
    "concurrency": 1,
    "disable-bail": true,
    "additional-timeout": 10000,
    "thresholds": {
      "high": 100,
      "low": 90,
      "break": 90
    }
  }
}
