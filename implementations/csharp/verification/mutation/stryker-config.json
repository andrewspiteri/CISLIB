{
  "stryker-config": {
    "project": "CIS.Core.csproj",
    "test-runner": "vstest",
    "target-framework": "net10.0",
    "configuration": "Release",
    "test-case-filter": "FullyQualifiedName~SeverityTokenParserTests",
    "mutate": [
      "Logging/Configuration/SeverityTokenParser.cs"
    ],
    "mutation-level": "Complete",
    "reporters": [
      "json",
      "html",
      "progress",
      "cleartext"
    ],
    "concurrency": 2,
    "additional-timeout": 10000,
    "thresholds": {
      "high": 100,
      "low": 90,
      "break": 90
    }
  }
}
