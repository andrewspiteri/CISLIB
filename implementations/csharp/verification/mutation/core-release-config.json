{
  "stryker-config": {
    "project": "CIS.Core.csproj",
    "test-projects": [
      "../../tests/CIS.Core.UnitTests/CIS.Core.UnitTests.csproj",
      "../../tests/CIS.Core.IntegrationTests/CIS.Core.IntegrationTests.csproj",
      "../../tests/CIS.Core.ArchitectureTests/CIS.Core.ArchitectureTests.csproj",
      "../../tests/CIS.Core.BusinessCases/CIS.Core.BusinessCases.csproj"
    ],
    "test-case-filter": "TestCategory!=PerformanceObservation&TestCategory!=ExtendedStress",
    "test-runner": "vstest",
    "target-framework": "net10.0",
    "configuration": "Release",
    "mutate": [
      "**/*.cs"
    ],
    "mutation-level": "Complete",
    "coverage-analysis": "off",
    "reporters": [
      "json",
      "html",
      "progress"
    ],
    "concurrency": 1,
    "disable-bail": true,
    "additional-timeout": 10000,
    "thresholds": {
      "high": 100,
      "low": 90,
      "break": 90
    }
  }
}
