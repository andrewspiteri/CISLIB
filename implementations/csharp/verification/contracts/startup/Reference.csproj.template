<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CIS.Core.ContractSpecification</AssemblyName>
    <ProduceOnlyReferenceAssembly>true</ProduceOnlyReferenceAssembly>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup><Compile Include="PublicSurface.cs" /><Compile Include="EventSurface.cs" /><Compile Include="RuntimeSurface.cs" /><Compile Include="ProviderSurface.cs" /></ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(MicrosoftLoggingAbstractionsPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
