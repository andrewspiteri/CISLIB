<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>CIS.TypeManager.BehaviorConsumer</AssemblyName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <NoWin32Manifest>true</NoWin32Manifest>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CIS.Core" HintPath="@@CORE@@" Private="true" />
    <Reference Include="CIS.TypeManager.BehaviorExtra" HintPath="@@EXTRA@@" Private="true" />
  </ItemGroup>
</Project>
