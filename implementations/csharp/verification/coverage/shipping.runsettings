<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration><TreatNoTestsAsError>true</TreatNoTestsAsError><MaxCpuCount>1</MaxCpuCount></RunConfiguration>
  <DataCollectionRunSettings><DataCollectors>
    <DataCollector friendlyName="Code Coverage" uri="datacollector://Microsoft/CodeCoverage/2.0">
      <Configuration>
        <Format>cobertura</Format><IncludeTestAssembly>false</IncludeTestAssembly>
        <ExcludeAssembliesWithoutSources>None</ExcludeAssembliesWithoutSources>
        <CodeCoverage>
          <ModulePaths mergeDefaults="False"><Include><ModulePath>.*[\\/]CIS\.Core\.dll$</ModulePath><ModulePath>.*[\\/]CIS\.TypeManager\.Build\.dll$</ModulePath></Include><Exclude /></ModulePaths>
          <Attributes mergeDefaults="False"><Exclude /></Attributes>
          <Sources mergeDefaults="False"><Exclude /></Sources>
          <Functions mergeDefaults="False"><Exclude /></Functions>
          <CompanyNames mergeDefaults="False"><Exclude /></CompanyNames>
          <PublicKeyTokens mergeDefaults="False"><Exclude /></PublicKeyTokens>
          <SkipAutoProperties>False</SkipAutoProperties>
          <CollectFromChildProcesses>True</CollectFromChildProcesses>
          <EnableDynamicManagedInstrumentation>True</EnableDynamicManagedInstrumentation>
          <EnableStaticManagedInstrumentation>False</EnableStaticManagedInstrumentation>
          <EnableDynamicNativeInstrumentation>False</EnableDynamicNativeInstrumentation>
          <EnableStaticNativeInstrumentation>False</EnableStaticNativeInstrumentation>
        </CodeCoverage>
      </Configuration>
    </DataCollector>
  </DataCollectors></DataCollectionRunSettings>
</RunSettings>
