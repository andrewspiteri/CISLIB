<Project>
  <Import Project="PackageVersion.props" />
  <PropertyGroup>
    <_CisTypeManagerSdkImported>true</_CisTypeManagerSdkImported>
    <_CisPreviousBeforeSdkTargets>$(BeforeMicrosoftNETSdkTargets)</_CisPreviousBeforeSdkTargets>
    <BeforeMicrosoftNETSdkTargets>$(MSBuildThisFileDirectory)BeforeSdk.targets</BeforeMicrosoftNETSdkTargets>
  </PropertyGroup>
</Project>
