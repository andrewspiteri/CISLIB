{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cis:audit:v1:security-operation-details",
  "title": "CIS Security reported operation details v1",
  "description": "Explicit producer schema for cis.security.operation.reported version 1. This is the original owner's reported fact, independent of Audit submission and transaction persistence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capabilities",
    "reportedOutcome"
  ],
  "properties": {
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
      }
    },
    "reportedOutcome": {
      "enum": [
        "completed",
        "failed",
        "canceled"
      ]
    },
    "outcomeCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    }
  }
}
