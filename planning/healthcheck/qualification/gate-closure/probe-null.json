{
  "stryker-config": {
    "project": "CIS.Core.csproj",
    "test-projects": [
      "../../tests/CIS.Core.UnitTests/CIS.Core.UnitTests.csproj"
    ],
    "test-case-filter": "FullyQualifiedName=CIS.Tests.UnitTests.Healthcheck.HealthProbeClientTransportTests.InvalidArgumentsNeverPrintSnapshotOrReturnHealthSuccess|FullyQualifiedName=CIS.Tests.TestAssemblySetup.SchedulingMatchesRequestedMode",
    "test-runner": "vstest",
    "target-framework": "net10.0",
    "configuration": "Release",
    "mutate": [
      "Healthcheck/Pipes/HealthProbeClient.cs"
    ],
    "mutation-level": "Complete",
    "reporters": [
      "json",
      "html",
      "progress",
      "cleartext"
    ],
    "coverage-analysis": "off",
    "concurrency": 2,
    "disable-bail": true,
    "additional-timeout": 60000,
    "thresholds": {
      "high": 100,
      "low": 90,
      "break": 90
    }
  }
}
