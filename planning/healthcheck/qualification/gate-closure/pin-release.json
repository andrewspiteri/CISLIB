{
  "stryker-config": {
    "project": "CIS.Core.csproj",
    "test-projects": [
      "../../tests/CIS.Core.IntegrationTests/CIS.Core.IntegrationTests.csproj"
    ],
    "test-case-filter": "FullyQualifiedName=CIS.Tests.IntegrationTests.Healthcheck.Reporting.HealthcheckPipeTransportTests.WindowsPipeEndpointDescriptorsReleasePinsAfterActualSettlement|FullyQualifiedName=CIS.Tests.TestAssemblySetup.SchedulingMatchesRequestedMode",
    "test-runner": "vstest",
    "target-framework": "net10.0",
    "configuration": "Release",
    "mutate": [
      "Healthcheck/Pipes/HealthPipeEndpoint.cs"
    ],
    "mutation-level": "Complete",
    "reporters": ["json", "cleartext", "progress"],
    "coverage-analysis": "off",
    "concurrency": 2,
    "disable-bail": true,
    "additional-timeout": 10000,
    "thresholds": {
      "high": 100,
      "low": 90,
      "break": 90
    }
  }
}
