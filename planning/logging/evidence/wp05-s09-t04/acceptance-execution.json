      "documentedContractStatus": null
    },
    {
      "id": "WP05-S09-AC02",
      "original": "Timer, explicit flush, and writes never execute concurrently on the same writer; blocked I/O delays completion but does not spawn accumulating timer tasks.",
      "bindings": {
        "timer": [
          "blocked-write",
          "blocked-flush",
          "continuous"
        ],
        "lifecycle": [
          "close-write",
          "close-flush"
