{
  "schemaVersion": 1,
  "caseCount": 18,
  "scope": "Specified runtime expectations only; no asynchronous lifecycle/provider/worker behavior executed by the pure contract checks.",
  "cases": [
    {
      "id": "LIFECYCLE-STOP-PRECANCELLED",
      "inputs": {
        "call": "StopAsync",
        "callerToken": "already-cancelled",
        "admissionOpen": true
      },
      "expected": {
        "admissionClosed": true,
        "sharedShutdownStarted": true,
        "caller": "OperationCanceledException"
      }
    },
    {
      "id": "LIFECYCLE-SHARED-DEADLINE",
      "inputs": {
        "shutdownTimeoutMs": 5000,
        "requests": [
          {
            "atElapsedMs": 0,
            "call": "StopAsync"
          },
          {
            "atElapsedMs": 2000,
            "call": "StopAsync"
          },
          {
            "atElapsedMs": 3000,
            "call": "DisposeAsync"
          }
        ]
      },
      "expected": {
        "sharedDeadlineElapsedMs": 5000,
        "operationsStarted": 1,
        "admissionReopened": false
      }
    },
    {
      "id": "LIFECYCLE-CANCELLED-STOP-WAIT",
      "inputs": {
        "firstStopStarted": true,
        "callerCancelsAtMs": 100
      },
      "expected": {
        "caller": "OperationCanceledException",
        "sharedShutdownContinues": true,
        "deadlineRestarted": false
      }
    },
    {
