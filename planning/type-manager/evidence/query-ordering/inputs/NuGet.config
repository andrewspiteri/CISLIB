<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="MSTest.Analyzers" />
      <package pattern="MSTest.TestAdapter" />
      <package pattern="MSTest.TestFramework" />
      <package pattern="Microsoft.ApplicationInsights" />
      <package pattern="Microsoft.CodeCoverage" />
      <package pattern="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <package pattern="Microsoft.Extensions.Logging.Abstractions" />
      <package pattern="Microsoft.NET.Test.Sdk" />
      <package pattern="Microsoft.TestPlatform.ObjectModel" />
      <package pattern="Microsoft.TestPlatform.TestHost" />
      <package pattern="Microsoft.Testing.Extensions.Telemetry" />
      <package pattern="Microsoft.Testing.Extensions.TrxReport.Abstractions" />
      <package pattern="Microsoft.Testing.Platform" />
      <package pattern="Microsoft.Testing.Platform.MSBuild" />
    </packageSource>
  </packageSourceMapping>
</configuration>
