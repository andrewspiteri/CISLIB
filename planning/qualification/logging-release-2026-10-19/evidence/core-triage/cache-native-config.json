{
  "stryker-config": {
    "project": "CIS.Core.csproj",
    "test-projects": ["../../tests/CIS.Core.UnitTests/CIS.Core.UnitTests.csproj"],
    "test-case-filter": "FullyQualifiedName~TypeManagerCatalogTests.WarmImplementationQueriesAvoidRepeatedCatalogSizedAllocations|FullyQualifiedName~TestAssemblySetup.SchedulingMatchesRequestedMode",
    "test-runner": "vstest",
    "target-framework": "net10.0",
    "configuration": "Release",
    "mutate": ["TypeManagement/TypeManager.cs"],
    "mutation-level": "Complete",
    "reporters": ["json", "html", "progress", "cleartext"],
    "concurrency": 4,
    "disable-bail": true,
    "additional-timeout": 10000,
    "thresholds": { "high": 100, "low": 90, "break": 90 }
  }
}
