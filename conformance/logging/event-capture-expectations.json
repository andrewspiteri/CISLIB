        "attributes": {
          "service": "attempt",
          "trace_id": "attempt",
          "span_id": "attempt",
          "operation_id": "attempt"
        }
      }
    },
    {
      "id": "CAPTURE-NO-VALID-ACTIVITY",
      "inputs": {
        "activity": {
          "format": "Hierarchical",
          "traceId": "11111111111111111111111111111111",
          "spanId": "2222222222222222"
        }
      },
      "expected": {
        "absent": [
          "trace_id",
          "span_id"
        ]
      }
    },
    {
      "id": "CAPTURE-NESTED-OWNERSHIP",
      "inputs": {
        "scopeAttributes": {
          "nested": {
            "array": [
              1,
              {
                "value": "original"
              }
            ]
          }
        },
        "mutationsAfterBeginScope": [
          {
            "path": [
              "nested",
              "array",
              1,
              "value"
            ],
            "value": "changed"
          }
        ],
        "eventAttributes": {
          "items": [
            {
              "value": "before"
            }
          ]
        },
        "mutationsAfterCapture": [
          {
            "path": [
              "items",
              0,
              "value"
            ],
            "value": "after"
          }
        ]
      },
      "expected": {
        "attributes": {
          "nested": {
            "array": [
              1,
              {
                "value": "original"
              }
            ]
          },
          "items": [
            {
              "value": "before"
            }
          ]
        }
      }
    },
    {
      "id": "CAPTURE-SCOPE-32",
      "inputs": {
        "scopeLevels": 32
      },
      "expected": {
        "beginScope": "Allowed"
