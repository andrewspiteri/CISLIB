{
  "schemaVersion": 1,
  "scope": "Specified runtime expectations only. WP04 must execute copy/merge/activity/exception/scopes against real capture; these are not results from the C# contract validator.",
  "caseCount": 22,
  "cases": [
    {
      "id": "CAPTURE-IDENTITY-ALLOWLIST",
      "inputs": {
        "metadata": {
          "ApplicationName": "orders-worker",
          "EnvironmentName": "qa",
          "ServiceVersion": "2.4.0",
          "BuildVersion": "2.4.0+AbC123"
        },
        "logging": {
          "FilePath": "private.log",
          "Destination": "private"
        }
      },
      "expected": {
        "service": "orders-worker",
        "env": "qa",
        "version": "2.4.0",
        "resource": {
          "build_version": "2.4.0+AbC123"
        },
        "excluded": [
          "logging",
          "FilePath",
          "Destination"
        ]
      }
    },
    {
      "id": "CAPTURE-NESTED-OVERRIDES",
      "inputs": {
        "scopes": [
          {
            "operationId": " outer ",
            "attributes": {
              "tenant": "one",
              "shared": "outer"
            }
          },
          {
            "operationId": " inner ",
            "attributes": {
              "shared": "inner"
            }
          }
        ],
        "event": {
          "operationId": " event ",
          "attributes": {
            "shared": "event"
          }
        }
      },
      "expected": {
        "operation_id": "event",
        "attributes": {
          "tenant": "one",
          "shared": "event"
        }
      }
    },
    {
      "id": "CAPTURE-BLANK-IDS",
      "inputs": {
