{
  "auditVersion": 1,
  "provenance": "Independently authored exact UTF-8 strings. Decode the manifest string as UTF-8 without reserializing its JSON content. Base64 carries intentionally invalid UTF-8.",
  "caseCount": 16,
  "cases": [
    {
      "id": "exact-opaque-original",
      "description": "Independent exact source bytes; opaque unknown JSON number is not converted through floating point.",
      "expectedValid": true,
      "wireUtf8": "{\"auditVersion\":1,\"auditId\":\"1fca92de-d6bb-45a7-92ea-00f391668ef9\",\"eventType\":\"example.future\",\"eventVersion\":19,\"category\":\"business\",\"occurredAtUtc\":\"2026-11-23T09:10:11Z\",\"recordedAtUtc\":\"2026-11-23T09:10:12.1234567Z\",\"producer\":{\"application\":\"orders\",\"environment\":\"test\"},\"actor\":{\"kind\":\"unknown\"},\"outcome\":\"succeeded\",\"details\":{\"amount\":\"9007199254740993.123456789\",\"currency\":\"EUR\",\"largeInteger\":9007199254740993}}"
    },
    {
      "id": "same-value-different-whitespace",
      "description": "Equivalent parsed values still have different original payload bytes.",
