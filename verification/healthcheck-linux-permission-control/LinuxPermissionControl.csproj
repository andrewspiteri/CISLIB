<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseSharedCompilation>false</UseSharedCompilation>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>CIS.Recovery.LinuxPermissionControl</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <None Include="requirements.json" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="CIS.Core.TestSupport">
      <HintPath>$(FrozenRunnerRoot)/CIS.Core.TestSupport.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireFrozenRunnerRoot" BeforeTargets="ResolveReferences">
    <Error Condition="'$(FrozenRunnerRoot)' == ''" Text="Supply the explicitly pinned FrozenRunnerRoot; this supplemental operator does not build the product or checker." />
  </Target>
</Project>
